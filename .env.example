# Delaxis — environment configuration
# Copy to .env and fill in what you need. Everything has a sensible default
# except the LLM API key.

# ============================================================
# LLM provider (required for real agent responses)
# ============================================================
# OpenRouter is the default provider (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
# Default model id (any LiteLLM-supported model works)
OPENROUTER_MODEL=openai/gpt-oss-20b
# LLM_PROVIDER=openrouter

# Other providers — set the key(s) for the providers you use.
# Providers are defined in configs/api_providers.json and can also be
# added/edited from the studio UI (Library > Providers).
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=          # Qwen via Alibaba Cloud DashScope
# ZHIPUAI_API_KEY=            # Zhipu GLM (bigmodel.cn)
# MOONSHOT_API_KEY=           # Moonshot Kimi
# XAI_API_KEY=                # xAI Grok
# ANTHROPIC_API_KEY=          # Anthropic Claude
# GROQ_API_KEY=               # Groq
# MISTRAL_API_KEY=            # Mistral AI
# Local/self-hosted endpoints (no key needed by default)
# OLLAMA_API_BASE=http://localhost:11434
# LM_STUDIO_API_BASE=http://localhost:1234/v1
# LM_STUDIO_API_KEY=
# VLLM_API_BASE=http://localhost:8000/v1
# VLLM_API_KEY=

# ============================================================
# Application
# ============================================================
# APP_PORT=8000
# LOG_LEVEL=INFO
# development = no auth required; production = auth enforced
# ENVIRONMENT=development
# Comma-separated allowed CORS origins, or * for all
# FRONTEND_URL=*

# ============================================================
# Database (SQLite by default — zero config)
# ============================================================
# DATABASE_URL=sqlite:///./data/delaxis.db
# For PostgreSQL (e.g. with `docker compose --profile postgres up`):
# DATABASE_URL=postgresql://delaxis:delaxis_pass@localhost:5432/delaxis
# DELAXIS_AUTO_MIGRATE=true

# ============================================================
# Authentication (optional)
# ============================================================
# Create the first admin account on boot (only if no users exist)
# DELAXIS_ADMIN_USERNAME=admin
# DELAXIS_ADMIN_PASSWORD=change-me
# JWT signing key — set a strong random value in production
# SECRET_KEY=change-this-in-production

# Optional Keycloak SSO
# KEYCLOAK_ENABLED=false
# KEYCLOAK_SERVER_URL=http://localhost:8080
# KEYCLOAK_REALM=my-realm
# KEYCLOAK_CLIENT_ID=delaxis-frontend
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_ADMIN_CLIENT_ID=delaxis-admin
# KEYCLOAK_ADMIN_CLIENT_SECRET=

# ============================================================
# Optional services
# ============================================================
# Redis cache
# REDIS_URL=redis://localhost:6379/0

# Qdrant vector store
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=knowledge_base

# External RAG pipeline service (powers the rag_* tools)
# Retrieval runs inside this app — there is no separate service to start, and
# the defaults below need no keys. Uncomment only to move the vectors or the
# embeddings somewhere else.
# RAG_PIPELINE_ENABLED=true

# Where vectors live: sqlite (default, a file in ./data) | qdrant | pgvector
# | pinecone | faiss | chromadb. Anything other than sqlite and pgvector needs
# its client installed: uv pip install -e ".[qdrant]" (or faiss/pinecone/chroma).
# RAG_BACKEND=sqlite
# RAG_DEFAULT_COLLECTION=knowledge-base
# RAG_CHUNK_CHARS=1400
# RAG_CHUNK_OVERLAP=220

# How text becomes vectors: local (default, no key, lexical matching) | openai
# | gemini. "openai" is any service speaking that API, so pointing base_url at
# Ollama, LM Studio, vLLM, OpenRouter or Together all work.
# RAG_EMBEDDING_PROVIDER=local
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
# RAG_EMBEDDING_DIMENSIONS=1536

# Per-backend settings, only for the one you chose.
# PGVECTOR_URL=postgresql://user:pass@localhost:5432/delaxis
# PGVECTOR_TABLE=rag_embeddings
# PINECONE_API_KEY=
# PINECONE_INDEX=delaxis
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# FAISS_PATH=./data/faiss
# CHROMA_PATH=./data/chromadb

# ============================================================
# Observability
# ============================================================
# ENABLE_METRICS=true
# PROMETHEUS_PORT=9090
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ============================================================
# Integrations (Gmail tools via Google OAuth 2.0)
# ============================================================
# Create OAuth client credentials (type: Web application) in Google Cloud Console,
# add the redirect URI below to its authorized redirect URIs, and enable the Gmail API.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback
# Required for storing Gmail tokens (Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# ENCRYPTION_KEY=

# Allow CrewAI tasks to block on stdin for human input (unsafe on headless servers)
# DELAXIS_ALLOW_HUMAN_INPUT=false

# ============================================================
# Live voice (Gemini Live)
# ============================================================
# Needs GEMINI_API_KEY above. Voice talks to the realtime model directly, so the
# canvas workflow's tools and routing do NOT run in voice mode — only the persona.
#
# A realtime session bills for as long as it stays open, and the voice WebSocket
# does not pass through the HTTP rate-limiting middleware, so these caps are the
# only backstop. Defaults are deliberately tight.
# DELAXIS_VOICE_ENABLED=true
# DELAXIS_VOICE_MAX_SESSION_SECONDS=300   # hard cap per session
# DELAXIS_VOICE_MAX_CONCURRENT=4          # process-wide concurrent sessions
# DELAXIS_VOICE_TICKET_TTL_SECONDS=30     # how long a WS ticket stays redeemable
#
# Which realtime model to use. Must be one of the ids listed under the provider's
# "live.models" in configs/api_providers.json — Google has shipped these under
# several names, so change the config rather than assuming a default is current.
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# ============================================================
# Renamed from Open Agent Kit (OAK) — migration notes
# ============================================================
# All OAK_* variables were renamed to DELAXIS_*. The old names still work for now
# and log a deprecation warning on first read; they are removed in 0.6.0.
#
# Three things do not migrate automatically:
#   - The default SQLite file moved to data/delaxis.db. If you have an existing
#     data/oak.db, run: mv data/oak.db data/delaxis.db
#     (startup warns and names the command if it finds the old file.)
#   - API keys issued before the rename start with oak_ and keep working;
#     newly created keys start with dlx_.
#   - Docker volume, Helm release and k8s namespace names all changed, so those
#     need a manual migration.
